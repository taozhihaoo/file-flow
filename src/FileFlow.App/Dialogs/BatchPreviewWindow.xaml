<Window x:Class="FileFlow.App.Dialogs.BatchPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileFlow.App.Localization"
        Title="{Binding Title}"
        Width="820"
        Height="640"
        MinWidth="660"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="38"
                    Height="38"
                    VerticalAlignment="Top"
                    Background="{StaticResource AccentLight}"
                    CornerRadius="10">
                <TextBlock Style="{StaticResource Glyph}"
                           FontSize="16"
                           Foreground="{StaticResource Accent}"
                           Text="&#xE70F;"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,0,0">
                <TextBlock FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Text="{Binding Title}"/>
                <TextBlock Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           Text="{Binding Description}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Rename rules -->
        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="14"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding ShowRuleEditor, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:T Preview_Rules}"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,8,0"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Preview_Prefix}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,14,0" Style="{StaticResource AppTextBox}" Tag="{loc:T Preview_PrefixPlaceholder}" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:T Preview_Suffix}"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource AppTextBox}" Tag="{loc:T Preview_SuffixPlaceholder}" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,9,8,0" Text="{loc:T Preview_Find}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,9,14,0" Style="{StaticResource AppTextBox}" Tag="{loc:T Preview_FindPlaceholder}" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,9,8,0" Text="{loc:T Preview_Replace}"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,9,0,0" Style="{StaticResource AppTextBox}" Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"/>

                    <CheckBox Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="0,12,0,0"
                              Content="{loc:T Preview_Sequential}"
                              IsChecked="{Binding UseSequentialNumbers}"
                              Style="{StaticResource AppCheckBox}"/>
                    <StackPanel Grid.Row="2"
                                Grid.Column="3"
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                IsEnabled="{Binding UseSequentialNumbers}">
                        <TextBlock Text="{loc:T Preview_Start}" Style="{StaticResource Muted}"/>
                        <TextBox Width="62" Style="{StaticResource AppTextBox}" Text="{Binding SequentialStart, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="12,0,8,0" Text="{loc:T Preview_Digits}" Style="{StaticResource Muted}"/>
                        <TextBox Width="62" Style="{StaticResource AppTextBox}" Text="{Binding SequentialPadding, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Preview list -->
        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <ListBox Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding Items}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="row"
                                            Padding="12,5"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource GridLine}"
                                            BorderThickness="0,0,0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{StaticResource RowHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       Text="{Binding From}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding From}"/>
                            <TextBlock Grid.Column="1"
                                       Margin="10,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDisabled}"
                                       Text="&#xE72A;"/>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="{Binding To}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding To}"/>
                            <TextBlock Grid.Column="3"
                                       Margin="10,0,0,0"
                                       MaxWidth="230"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource Danger}"
                                       Text="{Binding Error}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Error}"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Warning -->
        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12,9"
                Background="{StaticResource WarningSoft}"
                CornerRadius="9"
                Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Top"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="13"
                           Foreground="{StaticResource Warning}"
                           Text="&#xE7BA;"/>
                <TextBlock Margin="9,0,0,0"
                           FontSize="11.5"
                           Foreground="{StaticResource Warning}"
                           Text="{Binding Warning}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}"
                       Text="{Binding SummaryText}"
                       TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal">
                <Button MinWidth="92" Content="{loc:T Common_Cancel}" IsCancel="True" Style="{StaticResource AppButton}"/>
                <Button MinWidth="104"
                        Margin="10,0,0,0"
                        Command="{Binding ConfirmCommand}"
                        Content="{Binding ConfirmButtonText}"
                        IsDefault="True"
                        Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
