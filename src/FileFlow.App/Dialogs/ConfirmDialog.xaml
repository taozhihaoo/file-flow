<Window x:Class="FileFlow.App.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        WindowStyle="ToolWindow">
    <Border Padding="20" Background="{StaticResource Surface}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock FontFamily="{StaticResource IconFontFamily}"
                           FontSize="20"
                           Foreground="{StaticResource Warning}"
                           Text="&#xE7BA;"
                           VerticalAlignment="Center"/>
                <TextBlock Margin="10,0,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           MaxWidth="360"/>
            </StackPanel>
            <TextBlock Foreground="{StaticResource TextSecondary}"
                       Text="{Binding Details}"
                       TextWrapping="Wrap"
                       Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}"
                       Margin="0,0,0,10"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Cancel"
                        IsCancel="True"
                        MinWidth="90"
                        Style="{StaticResource AppButton}"/>
                <Button Command="{Binding ConfirmCommand}"
                        Content="{Binding ConfirmText}"
                        IsDefault="True"
                        MinWidth="90"
                        Margin="10,0,0,0"
                        Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
