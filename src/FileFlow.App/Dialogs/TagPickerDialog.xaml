<Window x:Class="FileFlow.App.Dialogs.TagPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="380"
        Height="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        WindowStyle="ToolWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Style="{StaticResource Muted}"
                   Text="{Binding Label}"/>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Tags}"
                 SelectedItem="{Binding SelectedTag}"
                 BorderBrush="{StaticResource SurfaceBorder}"
                 BorderThickness="1"
                 Background="{StaticResource Surface}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Margin="4" Text="{Binding Name}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <CheckBox Grid.Row="2"
                  Margin="0,10,0,0"
                  IsChecked="{Binding CreateNew}"
                  Style="{StaticResource AppCheckBox}"
                  Content="Create a new tag"/>
        <TextBox x:Name="NewTagBox"
                 Grid.Row="3"
                 Margin="0,8,0,0"
                 Style="{StaticResource AppTextBox}"
                 Tag="New tag name"
                 IsEnabled="{Binding CreateNew}"
                 Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Style="{StaticResource AppButton}"/>
            <Button Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsDefault="True" MinWidth="90" Margin="10,0,0,0" Style="{StaticResource AccentButton}"/>
        </StackPanel>
    </Grid>
</Window>
