<Window x:Class="FileFlow.App.Dialogs.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Surface}"
        WindowStyle="ToolWindow">
    <StackPanel Margin="20">
        <TextBlock FontSize="13"
                   Foreground="{StaticResource TextPrimary}"
                   Text="{Binding Label}"/>
        <TextBox x:Name="ValueBox"
                 Margin="0,10,0,0"
                 Style="{StaticResource AppTextBox}"
                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Margin="0,6,0,0"
                   Foreground="{StaticResource Danger}"
                   FontSize="12"
                   Text="{Binding ValidationError}"
                   Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibility}}"/>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Cancel"
                    IsCancel="True"
                    MinWidth="90"
                    Style="{StaticResource AppButton}"/>
            <Button Command="{Binding ConfirmCommand}"
                    Content="OK"
                    IsDefault="True"
                    MinWidth="90"
                    Margin="10,0,0,0"
                    Style="{StaticResource AccentButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
