<Window x:Class="FileFlow.App.Dialogs.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileFlow.App.Localization"
        Title="{Binding Title}"
        Width="464"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Surface}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStyle="ToolWindow">
    <StackPanel Margin="22">
        <TextBlock FontSize="13"
                   Foreground="{StaticResource TextPrimary}"
                   Text="{Binding Label}"
                   TextWrapping="Wrap"/>
        <TextBox x:Name="ValueBox"
                 Margin="0,10,0,0"
                 Style="{StaticResource AppTextBox}"
                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Margin="0,7,0,0"
                   FontSize="11.5"
                   Foreground="{StaticResource Danger}"
                   Text="{Binding ValidationError}"
                   Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibility}}"/>
        <Border Margin="0,18,0,0" Style="{StaticResource Divider}"/>
        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="92" Content="{loc:T Common_Cancel}" IsCancel="True" Style="{StaticResource AppButton}"/>
            <Button MinWidth="92"
                    Margin="10,0,0,0"
                    Command="{Binding ConfirmCommand}"
                    Content="{loc:T Common_OK}"
                    IsDefault="True"
                    Style="{StaticResource AccentButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
