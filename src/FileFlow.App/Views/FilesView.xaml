<UserControl x:Class="FileFlow.App.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:FileFlow.App.Behaviors">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== Scan panel ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBox x:Name="ScanFolderBox"
                             Width="380"
                             Style="{StaticResource AppTextBox}"
                             Tag="Folder to scan, e.g. D:\\Documents"
                             Text="{Binding ScanFolder, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Margin="8,0,0,0"
                            Command="{Binding BrowseScanFolderCommand}"
                            Content="Browse..."
                            Style="{StaticResource AppButton}"/>
                    <CheckBox Margin="16,0,0,0"
                              Content="Include subfolders"
                              IsChecked="{Binding ScanRecursive}"
                              Style="{StaticResource AppCheckBox}"/>
                    <CheckBox Margin="16,0,0,0"
                              Content="Include hidden files"
                              IsChecked="{Binding ScanIncludeHidden}"
                              Style="{StaticResource AppCheckBox}"/>
                    <Button Margin="16,0,0,0"
                            Command="{Binding ScanCommand}"
                            Content="Scan"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding ScanRunning, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource AccentButton}"/>
                    <Button Margin="8,0,0,0"
                            Command="{Binding CancelScanCommand}"
                            Content="Cancel"
                            IsEnabled="{Binding ScanRunning}"
                            Style="{StaticResource AppButton}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0"
                                 Height="6"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="{Binding ScanRunning, Mode=OneWay}"
                                 Maximum="100"
                                 Style="{StaticResource AppProgressBar}"
                                 Visibility="{Binding ScanRunning, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Grid.Column="1"
                               MaxWidth="560"
                               Style="{StaticResource Muted}"
                               Text="{Binding ScanStatusText}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== Search toolbar ==================== -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="12"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBox x:Name="SearchBox"
                                 Width="360"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource AppTextBox}"
                                 Tag="Search by name or path, e.g. invoice or .pdf"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Margin="10,0,0,0"
                                  Width="130"
                                  ItemsSource="{Binding Extensions}"
                                  SelectedItem="{Binding SelectedExtension}"
                                  Style="{StaticResource AppComboBox}"
                                  ToolTip="Filter by extension"/>
                        <ComboBox Margin="10,0,0,0"
                                  Width="140"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding Tags}"
                                  SelectedItem="{Binding SelectedTagFilter}"
                                  Style="{StaticResource AppComboBox}"
                                  ToolTip="Filter by tag">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <CheckBox Margin="14,0,0,0"
                                  Content="Missing only"
                                  IsChecked="{Binding OnlyMissing}"
                                  Style="{StaticResource AppCheckBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding ImportCommand}" Content="Import CSV..." Style="{StaticResource AppButton}"/>
                        <Button Margin="8,0,0,0" Command="{Binding ExportCommand}" Content="Export CSV..." Style="{StaticResource AppButton}"/>
                        <Button Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}" Content="Clear" Style="{StaticResource AppButton}"/>
                        <Button Margin="8,0,0,0" Command="{Binding SearchCommand}" Content="Search" Style="{StaticResource AppButton}"/>
                        <Button Margin="8,0,0,0" Command="{Binding RefreshFilesCommand}" Content="Verify on disk" Style="{StaticResource AppButton}" ToolTip="Re-check the listed files against the disk and update missing flags"/>
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}" Text="Size from"/>
                    <TextBox Width="90" Margin="6,0,0,0" Style="{StaticResource AppTextBox}" Tag="e.g. 10 MB" Text="{Binding SizeMinText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="to"/>
                    <TextBox Width="90" Margin="6,0,0,0" Style="{StaticResource AppTextBox}" Tag="e.g. 500 MB" Text="{Binding SizeMaxText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="Modified from"/>
                    <DatePicker Width="140" Margin="6,0,0,0" SelectedDate="{Binding ModifiedFrom}"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="to"/>
                    <DatePicker Width="140" Margin="6,0,0,0" SelectedDate="{Binding ModifiedTo}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== Results + details ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource SurfaceBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="FilesGrid"
                              ItemsSource="{Binding Results}"
                              SelectedItem="{Binding SelectedFile}"
                              behaviors:DataGridSelectionBehavior.BindSelection="{Binding SelectedRows}"
                              Style="{StaticResource AppDataGrid}"
                              Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibility}, ConverterParameter=invert}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding NameText}" Header="Name" MinWidth="180" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ExtensionText}" Header="Ext" Width="70"/>
                            <DataGridTextColumn Binding="{Binding SizeText}" Header="Size" Width="90"/>
                            <DataGridTextColumn Binding="{Binding ModifiedText}" Header="Modified" Width="130"/>
                            <DataGridTextColumn Binding="{Binding Tags}" Header="Tags" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,8,0"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   Foreground="{StaticResource Warning}"
                                                   Text="&#xE7BA;"
                                                   ToolTip="File is missing on disk"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding OpenFileCommand}" CommandParameter="{Binding SelectedFile}" Header="_Open"/>
                                <MenuItem Command="{Binding OpenContainingFolderCommand}" CommandParameter="{Binding SelectedFile}" Header="Open _containing folder"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="40"
                                   Foreground="{StaticResource TextDisabled}"
                                   Text="&#xE721;"/>
                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource H2}" Text="No files found"/>
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding ScanStatusText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Details panel -->
            <Border Grid.Column="2"
                    Padding="14"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource SurfaceBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Muted}"
                               Text="Select a file to see details."
                               Visibility="{Binding SelectedFile, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}"/>
                    <StackPanel Visibility="{Binding SelectedFile, Converter={StaticResource NullToVisibility}}">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="{Binding SelectedFile.NameText}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="{Binding SelectedFile.PathText}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Border Background="{StaticResource StatusRunningBackground}" Style="{StaticResource StatusPill}"
                                    Visibility="{Binding SelectedFile.IsMissing, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StatusRunningText}" Text="MISSING"/>
                            </Border>
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Margin" Value="0,3"/>
                                </Style>
                            </Grid.Resources>
                            <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextSecondary}" Text="Size"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="14,3,0,3" Foreground="{StaticResource TextPrimary}" Text="{Binding SelectedFile.SizeText}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextSecondary}" Text="Modified"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="14,3,0,3" Foreground="{StaticResource TextPrimary}" Text="{Binding SelectedFile.ModifiedText}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextSecondary}" Text="Created"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="14,3,0,3" Foreground="{StaticResource TextPrimary}" Text="{Binding SelectedFile.File.CreatedAtUtc, Converter={StaticResource UtcToLocal}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Foreground="{StaticResource TextSecondary}" Text="Scanned"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="14,3,0,3" Foreground="{StaticResource TextPrimary}" Text="{Binding SelectedFile.ScannedText}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Foreground="{StaticResource TextSecondary}" Text="Tags"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="14,3,0,3" Foreground="{StaticResource Accent}" Text="{Binding SelectedFile.Tags}" TextWrapping="Wrap"/>
                        </Grid>
                        <StackPanel Margin="0,16,0,0">
                            <Button Command="{Binding OpenFileCommand}" CommandParameter="{Binding SelectedFile}" Content="Open file" HorizontalAlignment="Stretch" Style="{StaticResource AppButton}"/>
                            <Button Margin="0,8,0,0"
                                    Command="{Binding OpenContainingFolderCommand}"
                                    CommandParameter="{Binding SelectedFile}"
                                    Content="Show in Explorer"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AppButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== Action bar ==================== -->
        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12,10"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Text="{Binding SelectedCount, StringFormat=Selected: {0:N0} file(s)}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding RenameCommand}" Content="Rename..." IsEnabled="{Binding HasSelection}" Style="{StaticResource AppButton}"/>
                    <Button Margin="8,0,0,0" Command="{Binding ChangeExtensionCommand}" Content="Change ext..." IsEnabled="{Binding HasSelection}" Style="{StaticResource AppButton}"/>
                    <Button Margin="8,0,0,0" Command="{Binding MoveCommand}" Content="Move..." IsEnabled="{Binding HasSelection}" Style="{StaticResource AppButton}"/>
                    <Button Margin="8,0,0,0" Command="{Binding CopyCommand}" Content="Copy..." IsEnabled="{Binding HasSelection}" Style="{StaticResource AppButton}"/>
                    <Button Margin="8,0,0,0" Command="{Binding AddTagCommand}" Content="Add tag..." IsEnabled="{Binding HasSelection}" Style="{StaticResource AppButton}"/>
                    <Button Margin="8,0,0,0" Command="{Binding RemoveTagCommand}" Content="Remove tag..." IsEnabled="{Binding HasSelection}" Style="{StaticResource AppButton}"/>
                    <Button Margin="8,0,0,0" Command="{Binding DeleteCommand}" Content="Delete..." IsEnabled="{Binding HasSelection}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
