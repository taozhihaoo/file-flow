<UserControl x:Class="FileFlow.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FileFlow.App.Localization">
    <Grid Margin="26,18,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,11" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            VerticalAlignment="Center"
                            Background="{StaticResource InfoSoft}"
                            CornerRadius="7">
                        <TextBlock Style="{StaticResource Glyph}"
                                   FontSize="12"
                                   Foreground="{StaticResource Info}"
                                   Text="&#xE946;"/>
                    </Border>
                    <TextBlock MaxWidth="620"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondary}"
                               Text="{loc:T Tasks_Hint}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding CancelCommand}"
                            Content="{loc:T Tasks_Cancel}"
                            IsEnabled="{Binding SelectedTask.CanCancel}"
                            Style="{StaticResource AppButton}"/>
                    <Button Margin="7,0,0,0"
                            Command="{Binding RetryFailedCommand}"
                            Content="{loc:T Tasks_Retry}"
                            IsEnabled="{Binding SelectedTask.CanRetry}"
                            Style="{StaticResource AppButton}"/>
                    <Button Margin="7,0,0,0"
                            Command="{Binding ClearFinishedCommand}"
                            Content="{loc:T Tasks_ClearFinished}"
                            Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Task list -->
            <Border Grid.Column="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource SurfaceBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <ListBox Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Tasks}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding SelectedTask}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="row"
                                                    Padding="14,12"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource GridLine}"
                                                    BorderThickness="0,0,0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource RowHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource RowSelected}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   Text="{Binding DescriptionText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Background="{Binding Task.State, Converter={StaticResource TaskStateToBackground}}"
                                                Style="{StaticResource StatusPill}">
                                            <TextBlock FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Task.State, Converter={StaticResource TaskStateToBrush}}"
                                                       Text="{Binding StateText}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Margin="0,5,0,5" Style="{StaticResource Caption}" Text="{Binding CountsText}"/>
                                    <ProgressBar Maximum="100"
                                                 Style="{StaticResource AppProgressBar}"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}"/>
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}" Text="{Binding CreatedText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Tasks.Count, Converter={StaticResource ZeroToVisibility}}">
                        <Border Width="52"
                                Height="52"
                                HorizontalAlignment="Center"
                                Background="{StaticResource SurfaceMuted}"
                                CornerRadius="14">
                            <TextBlock Style="{StaticResource Glyph}"
                                       FontSize="22"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="&#xE9F5;"/>
                        </Border>
                        <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource H2}" Text="{loc:T Tasks_EmptyTitle}"/>
                        <TextBlock Margin="0,5,0,0"
                                   MaxWidth="300"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource Muted}"
                                   Text="{loc:T Tasks_EmptyHint}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Task items -->
            <Border Grid.Column="2"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource SurfaceBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <DataGrid ItemsSource="{Binding SelectedTaskItems}"
                              Style="{StaticResource AppDataGrid}"
                              Visibility="{Binding SelectedTaskItems.Count, Converter={StaticResource ZeroToVisibility}, ConverterParameter=invert}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding StateText}" Header="{loc:T Tasks_ColStatus}" Width="92">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellPadding}">
                                        <Setter Property="FontSize" Value="11.5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding SourcePath}" Header="{loc:T Tasks_ColSource}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellPadding}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TargetPath}" Header="{loc:T Tasks_ColTarget}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellPadding}">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ErrorText}" Header="{loc:T Tasks_ColError}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellPadding}">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Muted}"
                               Text="{loc:T Tasks_SelectHint}"
                               Visibility="{Binding SelectedTaskItems.Count, Converter={StaticResource ZeroToVisibility}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
