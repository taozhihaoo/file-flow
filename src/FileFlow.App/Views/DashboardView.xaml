<UserControl x:Class="FileFlow.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FileFlow.App.Localization">
    <UserControl.Resources>
        <Style x:Key="KpiTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Padding" Value="16,15"/>
        </Style>
        <Style x:Key="KpiIcon" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource AccentLight}"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,20,26,26" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- ==================== KPI tiles ==================== -->
            <UniformGrid Columns="3" Rows="2">
                <Border Style="{StaticResource KpiTile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{loc:T Dash_FilesIndexed}"/>
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding FilesIndexed, StringFormat='{}{0:N0}'}"/>
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource Caption}"
                                       Text="{loc:T Dash_FilesIndexedHint}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource KpiIcon}" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Glyph}"
                                       FontSize="14"
                                       Foreground="{StaticResource Accent}"
                                       Text="&#xE8A5;"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource KpiTile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{loc:T Dash_LibrarySize}"/>
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalSizeText}"/>
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource Caption}"
                                       Text="{loc:T Dash_LibrarySizeHint}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                VerticalAlignment="Top"
                                Background="{StaticResource InfoSoft}"
                                Style="{StaticResource KpiIcon}">
                            <TextBlock Style="{StaticResource Glyph}"
                                       FontSize="14"
                                       Foreground="{StaticResource Info}"
                                       Text="&#xE8B7;"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource KpiTile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{loc:T Dash_Tags}"/>
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding TagCount, StringFormat='{}{0:N0}'}"/>
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource Caption}"
                                       Text="{loc:T Dash_TagsHint}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                VerticalAlignment="Top"
                                Background="{StaticResource SuccessSoft}"
                                Style="{StaticResource KpiIcon}">
                            <TextBlock Style="{StaticResource Glyph}"
                                       FontSize="14"
                                       Foreground="{StaticResource Success}"
                                       Text="&#xE8EC;"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource KpiTile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{loc:T Dash_Missing}"/>
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding MissingFiles, StringFormat='{}{0:N0}'}"/>
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource Caption}"
                                       Text="{loc:T Dash_MissingHint}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                VerticalAlignment="Top"
                                Background="{StaticResource WarningSoft}"
                                Style="{StaticResource KpiIcon}">
                            <TextBlock Style="{StaticResource Glyph}"
                                       FontSize="14"
                                       Foreground="{StaticResource Warning}"
                                       Text="&#xE7BA;"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource KpiTile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{loc:T Dash_ActiveTasks}"/>
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding ActiveTasks, StringFormat='{}{0:N0}'}"/>
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource Caption}"
                                       Text="{loc:T Dash_ActiveTasksHint}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                VerticalAlignment="Top"
                                Background="{StaticResource SurfaceMuted}"
                                Style="{StaticResource KpiIcon}">
                            <TextBlock Style="{StaticResource Glyph}"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondary}"
                                       Text="&#xE9F5;"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource KpiTile}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KpiLabel}" Text="{loc:T Dash_FailedOps}"/>
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding FailedOperations, StringFormat='{}{0:N0}'}"/>
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource Caption}"
                                       Text="{loc:T Dash_FailedOpsHint}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                VerticalAlignment="Top"
                                Background="{StaticResource DangerHover}"
                                Style="{StaticResource KpiIcon}">
                            <TextBlock Style="{StaticResource Glyph}"
                                       FontSize="14"
                                       Foreground="{StaticResource Danger}"
                                       Text="&#xE74D;"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ==================== Empty state ==================== -->
            <Border Margin="0,0,0,16"
                    Padding="26,24"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource AccentSoft}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            VerticalAlignment="Center"
                            Background="{StaticResource AccentLight}"
                            CornerRadius="12">
                        <TextBlock Style="{StaticResource Glyph}"
                                   FontSize="20"
                                   Foreground="{StaticResource Accent}"
                                   Text="&#xE8B7;"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H2}" Text="{loc:T Dash_EmptyTitle}"/>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" Text="{loc:T Dash_EmptyHint}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.NavigateToFilesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="{loc:T Dash_EmptyAction}"
                            Style="{StaticResource AccentButton}"/>
                </Grid>
            </Border>

            <!-- ==================== Activity ==================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="{loc:T Dash_RecentTasks}"/>
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource Caption}"
                                       Text="{Binding RecentTasks.Count, StringFormat='{}{0:N0}'}"/>
                        </Grid>
                        <Border Margin="0,12,0,0" Style="{StaticResource Divider}"/>
                        <TextBlock Margin="0,14,0,0"
                                   Style="{StaticResource Muted}"
                                   Text="{loc:T Dash_NoTasksHint}"
                                   Visibility="{Binding RecentTasks.Count, Converter={StaticResource ZeroToVisibility}}"/>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding RecentTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Foreground="{StaticResource TextPrimary}"
                                                       Text="{Binding DescriptionText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource Caption}"
                                                       Text="{Binding CountsText}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{Binding Task.State, Converter={StaticResource TaskStateToBackground}}"
                                                Style="{StaticResource StatusPill}">
                                            <TextBlock FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Task.State, Converter={StaticResource TaskStateToBrush}}"
                                                       Text="{Binding StateText}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="{loc:T Dash_RecentScans}"/>
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource Caption}"
                                       Text="{Binding RecentScans.Count, StringFormat='{}{0:N0}'}"/>
                        </Grid>
                        <Border Margin="0,12,0,0" Style="{StaticResource Divider}"/>
                        <TextBlock Margin="0,14,0,0"
                                   Style="{StaticResource Muted}"
                                   Text="{loc:T Dash_NoScansHint}"
                                   Visibility="{Binding RecentScans.Count, Converter={StaticResource ZeroToVisibility}}"/>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding RecentScans}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,7">
                                        <TextBlock Foreground="{StaticResource TextPrimary}"
                                                   Text="{Binding DescriptionText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding WhenText}"/>
                                            <TextBlock Margin="10,0,0,0" Style="{StaticResource Caption}" Text="{Binding CountsText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
