<UserControl x:Class="FileFlow.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Stat cards -->
            <UniformGrid Columns="3" Rows="2">
                <UniformGrid.Resources>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Margin" Value="0,0,16,16"/>
                    </Style>
                </UniformGrid.Resources>
                <Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="FILES INDEXED"/>
                        <TextBlock Margin="0,6,0,0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Text="{Binding FilesIndexed, StringFormat='{}{0:N0}'}"/>
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="LIBRARY SIZE"/>
                        <TextBlock Margin="0,6,0,0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Text="{Binding TotalSizeText}"/>
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="TAGS"/>
                        <TextBlock Margin="0,6,0,0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Text="{Binding TagCount, StringFormat='{}{0:N0}'}"/>
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="MISSING FILES"/>
                        <TextBlock Margin="0,6,0,0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Text="{Binding MissingFiles, StringFormat='{}{0:N0}'}"/>
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="ACTIVE TASKS"/>
                        <TextBlock Margin="0,6,0,0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Text="{Binding ActiveTasks, StringFormat='{}{0:N0}'}"/>
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="OPERATIONS WITH FAILURES"/>
                        <TextBlock Margin="0,6,0,0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Text="{Binding FailedOperations, StringFormat='{}{0:N0}'}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Empty state -->
            <Border Margin="0,0,0,16"
                    Padding="28"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource SurfaceBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="36"
                               Foreground="{StaticResource Accent}"
                               Text="&#xE8B7;"/>
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource H2}" Text="Your library is empty"/>
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Muted}"
                               Text="Go to the Files page, choose a folder and press Scan to index your first files."/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recent tasks -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Recent tasks"/>
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource Muted}"
                                   Text="No tasks yet. Batch operations appear here."
                                   Visibility="{Binding RecentTasks.Count, Converter={StaticResource ZeroToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding RecentTasks}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Foreground="{StaticResource TextPrimary}" Text="{Binding DescriptionText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Muted}" Text="{Binding CountsText}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Background="{Binding Task.State, Converter={StaticResource TaskStateToBackground}}"
                                                Style="{StaticResource StatusPill}">
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Task.State, Converter={StaticResource TaskStateToBrush}}"
                                                       Text="{Binding StateText}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent scans -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Recent scans"/>
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource Muted}"
                                   Text="No scans yet."
                                   Visibility="{Binding RecentScans.Count, Converter={StaticResource ZeroToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding RecentScans}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6">
                                        <TextBlock Foreground="{StaticResource TextPrimary}" Text="{Binding DescriptionText}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding WhenText}"/>
                                            <TextBlock Margin="10,0,0,0" Style="{StaticResource Muted}" Text="{Binding CountsText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
