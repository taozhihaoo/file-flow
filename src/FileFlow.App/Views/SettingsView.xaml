<UserControl x:Class="FileFlow.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FileFlow.App.Localization">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,9,0,0"/>
        </Style>
        <Style x:Key="PathText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CardHeader" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,18,26,26" MaxWidth="820" HorizontalAlignment="Left">

            <!-- Appearance -->
            <Border Margin="0,0,0,14" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Appearance}"/>
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{loc:T Settings_AppearanceHint}"/>
                    </StackPanel>
                    <Border Margin="0,12,0,0" Style="{StaticResource Divider}"/>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Width="220"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="{loc:T Settings_Language}"/>
                        <ComboBox MinWidth="170"
                                  DisplayMemberPath="Display"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  Style="{StaticResource AppComboBox}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Scanning -->
            <Border Margin="0,0,0,14" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Scanning}"/>
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{loc:T Settings_ScanningHint}"/>
                    </StackPanel>
                    <Border Margin="0,12,0,0" Style="{StaticResource Divider}"/>
                    <CheckBox Margin="0,12,0,0"
                              Content="{loc:T Settings_Subfolders}"
                              IsChecked="{Binding ScanRecursive}"
                              Style="{StaticResource AppCheckBox}"/>
                    <CheckBox Margin="0,10,0,0"
                              Content="{loc:T Settings_Hidden}"
                              IsChecked="{Binding ScanIncludeHidden}"
                              Style="{StaticResource AppCheckBox}"/>
                </StackPanel>
            </Border>

            <!-- Operations -->
            <Border Margin="0,0,0,14" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Operations}"/>
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{loc:T Settings_OperationsHint}"/>
                    </StackPanel>
                    <Border Margin="0,12,0,0" Style="{StaticResource Divider}"/>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Width="220"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="{loc:T Settings_MaxConcurrent}"/>
                        <Slider Width="230"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                Maximum="16"
                                Minimum="1"
                                Style="{StaticResource AppSlider}"
                                TickFrequency="1"
                                Value="{Binding MaxConcurrentOperations}"/>
                        <Border MinWidth="34"
                                Margin="14,0,0,0"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentLight}"
                                CornerRadius="7">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentPressed}"
                                       Text="{Binding ConcurrentOperationsValue}"/>
                        </Border>
                    </StackPanel>
                    <CheckBox Margin="0,14,0,0"
                              Content="{loc:T Settings_ConfirmDestructive}"
                              IsChecked="{Binding ConfirmDestructiveOperations}"
                              Style="{StaticResource AppCheckBox}"/>
                    <CheckBox Margin="0,10,0,0"
                              Content="{loc:T Settings_RecycleBin}"
                              IsChecked="{Binding DeleteToRecycleBin}"
                              Style="{StaticResource AppCheckBox}"/>
                </StackPanel>
            </Border>

            <!-- Import / export -->
            <Border Margin="0,0,0,14" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_ImportExport}"/>
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{loc:T Settings_ExportHint}"/>
                    </StackPanel>
                    <Border Margin="0,12,0,0" Style="{StaticResource Divider}"/>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBox Width="430"
                                 Style="{StaticResource AppTextBox}"
                                 Tag="{loc:T Settings_ExportPlaceholder}"
                                 Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Margin="8,0,0,0"
                                Command="{Binding BrowseExportDirectoryCommand}"
                                Content="{loc:T Common_Browse}"
                                Style="{StaticResource AppButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Logging -->
            <Border Margin="0,0,0,14" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Logging}"/>
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{loc:T Settings_LoggingHint}"/>
                    </StackPanel>
                    <Border Margin="0,12,0,0" Style="{StaticResource Divider}"/>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Width="220"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="{loc:T Settings_LogLevel}"/>
                        <ComboBox MinWidth="150"
                                  ItemsSource="{Binding LogLevelOptions}"
                                  SelectedItem="{Binding LogLevel}"
                                  Style="{StaticResource AppComboBox}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource PathText}" Text="{Binding LogFolderText}" ToolTip="{Binding LogsDirectoryText}"/>
                </StackPanel>
            </Border>

            <!-- Data locations -->
            <Border Margin="0,0,0,16" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Data}"/>
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{loc:T Settings_DataHint}"/>
                    </StackPanel>
                    <Border Margin="0,12,0,0" Style="{StaticResource Divider}"/>
                    <TextBlock Style="{StaticResource PathText}" Text="{Binding DatabaseText}" ToolTip="{Binding DatabasePathText}"/>
                    <TextBlock Style="{StaticResource PathText}" Text="{Binding DataFolderText}" ToolTip="{Binding DataDirectoryText}"/>
                    <TextBlock Style="{StaticResource PathText}" Text="{Binding LogFolderText}" ToolTip="{Binding LogsDirectoryText}"/>
                    <Button Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenDataFolderCommand}"
                            Content="{loc:T Settings_OpenData}"
                            Style="{StaticResource AppButton}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button MinWidth="140" Command="{Binding SaveCommand}" Content="{loc:T Settings_Save}" Style="{StaticResource AccentButton}"/>
                <Button MinWidth="140"
                        Margin="10,0,0,0"
                        Command="{Binding ResetToDefaultsCommand}"
                        Content="{loc:T Settings_Reset}"
                        Style="{StaticResource AppButton}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
