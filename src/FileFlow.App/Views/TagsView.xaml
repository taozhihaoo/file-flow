<UserControl x:Class="FileFlow.App.Views.TagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FileFlow.App.Localization">
    <Grid Margin="26,18,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,11" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            VerticalAlignment="Center"
                            Background="{StaticResource SuccessSoft}"
                            CornerRadius="7">
                        <TextBlock Style="{StaticResource Glyph}"
                                   FontSize="12"
                                   Foreground="{StaticResource Success}"
                                   Text="&#xE8EC;"/>
                    </Border>
                    <TextBlock MaxWidth="620"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondary}"
                               Text="{loc:T Tags_Hint}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding NewCommand}" Content="{loc:T Tags_New}" Style="{StaticResource AccentButton}"/>
                    <Button Margin="7,0,0,0" Command="{Binding RenameCommand}" Content="{loc:T Tags_Rename}" IsEnabled="{Binding HasSelection}" Style="{StaticResource AppButton}"/>
                    <Button Margin="7,0,0,0" Command="{Binding DeleteCommand}" Content="{loc:T Tags_Delete}" IsEnabled="{Binding HasSelection}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Tags}"
                          SelectedItem="{Binding SelectedTag}"
                          Style="{StaticResource AppDataGrid}"
                          Visibility="{Binding Tags.Count, Converter={StaticResource ZeroToVisibility}, ConverterParameter=invert}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}" Header="{loc:T Tags_ColTag}" MinWidth="200" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FileCount, StringFormat='{}{0:N0}'}" Header="{loc:T Tags_ColFiles}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellPadding}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding CreatedAtUtc, Converter={StaticResource UtcToLocal}}" Header="{loc:T Tags_ColCreated}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellPadding}">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding Tags.Count, Converter={StaticResource ZeroToVisibility}}">
                    <Border Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Background="{StaticResource SurfaceMuted}"
                            CornerRadius="14">
                        <TextBlock Style="{StaticResource Glyph}"
                                   FontSize="22"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="&#xE8EC;"/>
                    </Border>
                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource H2}" Text="{loc:T Tags_EmptyTitle}"/>
                    <TextBlock Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource Muted}"
                               Text="{loc:T Tags_EmptyHint}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
