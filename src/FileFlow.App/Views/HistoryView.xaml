<UserControl x:Class="FileFlow.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FileFlow.App.Localization">
    <Grid Margin="26,18,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,11" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceMuted}"
                            CornerRadius="7">
                        <TextBlock Style="{StaticResource Glyph}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="&#xE71C;"/>
                    </Border>
                    <TextBlock Margin="10,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               Text="{loc:T History_TypeFilter}"/>
                    <ComboBox MinWidth="170"
                              DisplayMemberPath="Display"
                              ItemsSource="{Binding TypeFilters}"
                              SelectedItem="{Binding SelectedTypeFilter}"
                              Style="{StaticResource AppComboBox}"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding LoadMoreCommand}"
                        Content="{loc:T Common_LoadMore}"
                        IsEnabled="{Binding CanLoadMore}"
                        Style="{StaticResource AppButton}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Operations}"
                          IsReadOnly="True"
                          Style="{StaticResource AppDataGrid}"
                          Visibility="{Binding Operations.Count, Converter={StaticResource ZeroToVisibility}, ConverterParameter=invert}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding WhenText}" Header="{loc:T History_ColWhen}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellPadding}">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding TypeText}" Header="{loc:T History_ColOperation}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellPadding}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DescriptionText}" Header="{loc:T History_ColDetails}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellPadding}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding CountsText}" Header="{loc:T History_ColResult}" Width="230">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellPadding}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding Operations.Count, Converter={StaticResource ZeroToVisibility}}">
                    <Border Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Background="{StaticResource SurfaceMuted}"
                            CornerRadius="14">
                        <TextBlock Style="{StaticResource Glyph}"
                                   FontSize="22"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="&#xE81C;"/>
                    </Border>
                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource H2}" Text="{loc:T History_EmptyTitle}"/>
                    <TextBlock Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource Muted}"
                               Text="{loc:T History_EmptyHint}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
