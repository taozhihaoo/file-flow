<UserControl x:Class="FileFlow.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="12,10"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}" Text="Operation type"/>
                    <ComboBox Margin="10,0,0,0"
                              ItemsSource="{Binding TypeFilters}"
                              SelectedItem="{Binding SelectedTypeFilter}"
                              Style="{StaticResource AppComboBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding LoadMoreCommand}"
                            Content="Load more"
                            IsEnabled="{Binding CanLoadMore}"
                            Style="{StaticResource AppButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Operations}"
                          Style="{StaticResource AppDataGrid}"
                          IsReadOnly="True"
                          Visibility="{Binding Operations.Count, Converter={StaticResource ZeroToVisibility}, ConverterParameter=invert}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding WhenText}" Header="When" Width="150"/>
                        <DataGridTextColumn Binding="{Binding TypeText}" Header="Operation" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DescriptionText}" Header="Details" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding CountsText}" Header="Result" Width="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding Operations.Count, Converter={StaticResource ZeroToVisibility}}">
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="40"
                               Foreground="{StaticResource TextDisabled}"
                               Text="&#xE81C;"/>
                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource H2}" Text="No operations recorded yet"/>
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Muted}" Text="Scans, batch operations and imports are recorded here."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
