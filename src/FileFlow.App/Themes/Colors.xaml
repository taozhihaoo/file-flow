<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base palette -->
    <Color x:Key="WindowBackgroundColor">#F5F6F8</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}"/>

    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBorder" Color="#E3E6EA"/>
    <SolidColorBrush x:Key="SurfaceMuted" Color="#FAFBFC"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackground" Color="#1F2937"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#374151"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#2563EB"/>
    <SolidColorBrush x:Key="SidebarText" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="SidebarTextMuted" Color="#9CA3AF"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#1E40AF"/>
    <SolidColorBrush x:Key="AccentLight" Color="#DBEAFE"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerHover" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="Success" Color="#15803D"/>
    <SolidColorBrush x:Key="Warning" Color="#B45309"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#9CA3AF"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="ControlBorderFocus" Color="#2563EB"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="PressedBackground" Color="#E5E7EB"/>

    <!-- Rows -->
    <SolidColorBrush x:Key="RowHover" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="RowSelected" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="RowAlternate" Color="#FAFBFC"/>
    <SolidColorBrush x:Key="GridLine" Color="#F1F2F4"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#F9FAFB"/>

    <!-- Status pills: task states -->
    <SolidColorBrush x:Key="StatusQueuedBackground" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="StatusQueuedText" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="StatusRunningBackground" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="StatusRunningText" Color="#B45309"/>
    <SolidColorBrush x:Key="StatusCompletedBackground" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="StatusCompletedText" Color="#15803D"/>
    <SolidColorBrush x:Key="StatusPartialBackground" Color="#FFEDD5"/>
    <SolidColorBrush x:Key="StatusPartialText" Color="#C2410C"/>
    <SolidColorBrush x:Key="StatusFailedBackground" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="StatusFailedText" Color="#B91C1C"/>
    <SolidColorBrush x:Key="StatusCancelledBackground" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="StatusCancelledText" Color="#6B7280"/>
    <SolidColorBrush x:Key="StatusInterruptedBackground" Color="#F3E8FF"/>
    <SolidColorBrush x:Key="StatusInterruptedText" Color="#7E22CE"/>
</ResourceDictionary>
