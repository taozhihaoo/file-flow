<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         FileFlow palette
         Indigo accent on cool neutral surfaces, deep navy sidebar.
         ============================================================ -->

    <!-- Window / surfaces -->
    <Color x:Key="WindowBackgroundColor">#F4F6FB</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F9FAFD"/>
    <SolidColorBrush x:Key="SurfaceMuted" Color="#F2F4FA"/>
    <SolidColorBrush x:Key="SurfaceBorder" Color="#E5E9F3"/>
    <SolidColorBrush x:Key="SurfaceBorderStrong" Color="#D2D9E9"/>

    <!-- Sidebar -->
    <LinearGradientBrush x:Key="SidebarBackground" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Offset="0" Color="#18203A"/>
        <GradientStop Offset="0.55" Color="#141B31"/>
        <GradientStop Offset="1" Color="#0E1424"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarHover" Color="#223050"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#2A3A61"/>
    <SolidColorBrush x:Key="SidebarIndicator" Color="#8B93FF"/>
    <SolidColorBrush x:Key="SidebarText" Color="#C8D2E6"/>
    <SolidColorBrush x:Key="SidebarTextMuted" Color="#78859F"/>
    <SolidColorBrush x:Key="SidebarDivider" Color="#25304A"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentHover" Color="#4338CA"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#3730A3"/>
    <SolidColorBrush x:Key="AccentLight" Color="#EEF0FF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E4E7FF"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6366F1"/>
        <GradientStop Offset="1" Color="#A855F7"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentLineGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#6366F1"/>
        <GradientStop Offset="1" Color="#22D3EE"/>
    </LinearGradientBrush>

    <!-- Semantic -->
    <SolidColorBrush x:Key="Danger" Color="#D92D20"/>
    <SolidColorBrush x:Key="DangerHover" Color="#FEF1F0"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FEE4E2"/>
    <SolidColorBrush x:Key="Success" Color="#0E9F6E"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#E6F8F1"/>
    <SolidColorBrush x:Key="Warning" Color="#B54708"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#FFF4E5"/>
    <SolidColorBrush x:Key="Info" Color="#175CD3"/>
    <SolidColorBrush x:Key="InfoSoft" Color="#EAF2FF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5A6478"/>
    <SolidColorBrush x:Key="TextMuted" Color="#8A93A6"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#A6AEC0"/>
    <SolidColorBrush x:Key="TextInverse" Color="#FFFFFF"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#DCE2EF"/>
    <SolidColorBrush x:Key="ControlBorderStrong" Color="#C6CFE3"/>
    <SolidColorBrush x:Key="ControlBorderFocus" Color="#6366F1"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#F4F6FC"/>
    <SolidColorBrush x:Key="PressedBackground" Color="#EAEEF9"/>

    <!-- Rows / grid -->
    <SolidColorBrush x:Key="RowHover" Color="#F4F6FC"/>
    <SolidColorBrush x:Key="RowSelected" Color="#EAEDFF"/>
    <SolidColorBrush x:Key="RowAlternate" Color="#FBFCFE"/>
    <SolidColorBrush x:Key="GridLine" Color="#EEF1F8"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#F7F9FD"/>

    <!-- Status pills: task states -->
    <SolidColorBrush x:Key="StatusQueuedBackground" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="StatusQueuedText" Color="#175CD3"/>
    <SolidColorBrush x:Key="StatusRunningBackground" Color="#FFF4E5"/>
    <SolidColorBrush x:Key="StatusRunningText" Color="#B54708"/>
    <SolidColorBrush x:Key="StatusCompletedBackground" Color="#E6F8F1"/>
    <SolidColorBrush x:Key="StatusCompletedText" Color="#0E7C58"/>
    <SolidColorBrush x:Key="StatusPartialBackground" Color="#FFEEE4"/>
    <SolidColorBrush x:Key="StatusPartialText" Color="#C2410C"/>
    <SolidColorBrush x:Key="StatusFailedBackground" Color="#FEE4E2"/>
    <SolidColorBrush x:Key="StatusFailedText" Color="#B42318"/>
    <SolidColorBrush x:Key="StatusCancelledBackground" Color="#F2F4FA"/>
    <SolidColorBrush x:Key="StatusCancelledText" Color="#5A6478"/>
    <SolidColorBrush x:Key="StatusInterruptedBackground" Color="#F4EBFF"/>
    <SolidColorBrush x:Key="StatusInterruptedText" Color="#7338B8"/>
</ResourceDictionary>
